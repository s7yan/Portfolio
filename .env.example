# ── AI Concierge (optional) ─────────────────────────────────────────────
# When set, the "Ask me anything" panel answers questions with Claude,
# grounded in the content files under src/content. Without it, the panel
# shows a graceful "offline" response.
ANTHROPIC_API_KEY=

# ── Analytics (all optional — enable any provider by setting its key) ───
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Vercel Analytics activates automatically when deployed on Vercel with
# the dashboard toggle enabled — no env var needed.

# ── Site URL (used for canonical/OG/sitemap) ────────────────────────────
NEXT_PUBLIC_SITE_URL=https://sayandas.design
